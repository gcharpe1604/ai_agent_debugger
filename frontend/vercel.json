{
  "buildCommand": "node ../scripts/build-vercel.mjs",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/docs", "destination": "/docs/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://agentdbg-api.onrender.com/api/:path*" },
    { "source": "/((?!docs/|docs$).*)", "destination": "/index.html" }
  ]
}
