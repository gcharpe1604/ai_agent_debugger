{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://agentdbg-api.onrender.com/api/:path*" },
    { "source": "/docs", "destination": "https://agentdbg-docs.vercel.app/docs/" },
    { "source": "/docs/:path*", "destination": "https://agentdbg-docs.vercel.app/docs/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
