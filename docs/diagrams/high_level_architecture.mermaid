flowchart LR
    AGENT[Developer AI Agent]

    subgraph SDKBOX[Instrumentation]
        SDK[Thin Python Debugger SDK]
        OTEL[OpenTelemetry API / SDK]
        EXPORT[Batched HTTPS/JSON Export]
        SDK --> OTEL --> EXPORT
    end

    subgraph BACKEND[Hosted Platform]
        INGEST[FastAPI Ingestion]
        KAFKA[(Kafka)]
        WRITER[Trace Writer Consumer]
        CH[(ClickHouse<br/>Trace Telemetry)]
        PG[(PostgreSQL<br/>Control / Analysis / Knowledge)]
        RECON[Trace Reconstruction]
        INVEST[Debugger Investigator]
        GROUND[Evidence Grounding]
        API[Debugging APIs]
    end

    UI[React Debugging UI]

    AGENT --> SDK
    EXPORT --> INGEST --> KAFKA --> WRITER --> CH
    CH --> RECON --> INVEST
    PG --> INVEST
    INVEST --> GROUND --> PG
    CH --> API
    PG --> API
    API --> UI
