flowchart LR
    subgraph DEV[Developer Environment]
        A[AI Agent]
        S[Thin Debugger SDK<br/>OpenTelemetry]
        A --> S
    end

    USER[Developer Browser]

    subgraph HOST[Hosted Debugging Platform]
        UI[React UI]
        API[FastAPI Modular Monolith]
        K[(Kafka)]
        W[Trace Writer Consumer]
        CH[(Managed ClickHouse)]
        PG[(Managed PostgreSQL<br/>+ optional pgvector)]
        LLM[LLM Provider]

        API --> K --> W --> CH
        API <--> PG
        API <--> CH
        API <--> LLM
        UI --> API
    end

    S -->|HTTPS/JSON| API
    USER --> UI
