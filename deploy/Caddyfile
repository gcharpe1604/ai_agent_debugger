# SITE_ADDRESS from .env.prod: a domain (e.g. debugger.example.com) gets a Let's Encrypt
# certificate; "localhost" gets a certificate from Caddy's own local CA.
{$SITE_ADDRESS} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8008 {
			transport http {
				read_timeout 120s
			}
		}
	}

	# Docs (Astro Starlight, built into /srv/docs). Before the SPA fallback, so
	# /docs/... never falls through to index.html. /docs redirects to /docs/.
	@docs path /docs /docs/*
	handle @docs {
		root * /srv
		@docsAssets path /docs/_astro/*
		header @docsAssets Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		# Vite file names under /assets carry a content hash.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
