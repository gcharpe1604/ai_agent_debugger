# compose.prod.yaml settings. Copy to .env.prod (git-ignored) and fill in every CHANGE_ME.
# Every container reads this file. Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Public address Caddy serves. A domain whose DNS points at this VM gets a Let's Encrypt
# certificate (ports 80 and 443 must be open). "localhost" uses Caddy's local CA (testing only).
SITE_ADDRESS=debugger.example.com

# PostgreSQL (users and API keys). POSTGRES_PASSWORD must match the password in DATABASE_URL.
POSTGRES_DB=agent_debugger
POSTGRES_USER=agent_debugger
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+asyncpg://agent_debugger:CHANGE_ME@postgres:5432/agent_debugger

# ClickHouse (spans). The image creates this user and database on first start;
# the API and trace writer use the same names.
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=telemetry
CLICKHOUSE_DATABASE=telemetry
CLICKHOUSE_USER=agentdbg
CLICKHOUSE_PASSWORD=CHANGE_ME

# Kafka: the compose network listener. Topics are created by kafka-init.
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TRACE_TOPIC=agentdbg.traces.v1
KAFKA_TRACE_DLQ_TOPIC=agentdbg.traces.v1.dlq
KAFKA_TRACE_WRITER_GROUP=agentdbg-trace-writer
KAFKA_PUBLISH_TIMEOUT_S=10
DEFAULT_PROJECT_ID=00000000-0000-4000-8000-000000000001

# UI sessions. SESSION_SECRET: at least 32 characters (the command above gives 43).
SESSION_SECRET=CHANGE_ME
SESSION_COOKIE_SECURE=true
# false turns public sign-up off; scripts/create_user.py still creates users.
ALLOW_SIGNUP=true
