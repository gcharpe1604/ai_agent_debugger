DATABASE_URL=postgresql+asyncpg://agent_debugger:agent_debugger@localhost:5433/agent_debugger

# Durable pipeline (local compose). Processes on the host use the HOST listener.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TRACE_TOPIC=agentdbg.traces.v1
KAFKA_TRACE_DLQ_TOPIC=agentdbg.traces.v1.dlq
KAFKA_TRACE_WRITER_GROUP=agentdbg-trace-writer

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=telemetry
CLICKHOUSE_USER=agentdbg
CLICKHOUSE_PASSWORD=agentdbg
