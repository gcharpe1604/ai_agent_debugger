DATABASE_URL=postgresql+asyncpg://agent_debugger:agent_debugger@localhost:5433/agent_debugger

# Durable pipeline (local compose). Processes on the host use the HOST listener.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TRACE_TOPIC=spanhelix.traces.v1
KAFKA_TRACE_DLQ_TOPIC=spanhelix.traces.v1.dlq
KAFKA_TRACE_WRITER_GROUP=spanhelix-trace-writer

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=spanhelix
CLICKHOUSE_USER=spanhelix
CLICKHOUSE_PASSWORD=spanhelix
