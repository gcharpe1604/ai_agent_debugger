DATABASE_URL=postgresql+asyncpg://agent_debugger:agent_debugger@localhost:5433/agent_debugger

# Durable pipeline (local compose). Processes on the host use the HOST listener.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TRACE_TOPIC=agentdbg.traces.v1
KAFKA_TRACE_DLQ_TOPIC=agentdbg.traces.v1.dlq
KAFKA_TRACE_WRITER_GROUP=agentdbg-trace-writer
# POST /api/v1/traces: max seconds to wait for every span to be broker-acked (else 503).
KAFKA_PUBLISH_TIMEOUT_S=10
# Project of the first user ever created (register or scripts/create_user.py), so spans
# written before accounts existed stay readable. Never sent by clients.
DEFAULT_PROJECT_ID=00000000-0000-4000-8000-000000000001

# Signs the UI session cookie. Required, at least 32 characters: the backend does not start
# without it. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# true when the UI is served over https (the session cookie then gets the Secure flag).
SESSION_COOKIE_SECURE=false
# false turns POST /api/v1/auth/register off (403); scripts/create_user.py still creates users.
ALLOW_SIGNUP=true

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=telemetry
CLICKHOUSE_USER=agentdbg
CLICKHOUSE_PASSWORD=agentdbg
