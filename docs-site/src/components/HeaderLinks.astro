---
// Header: "Open app" (the web UI at the site root) before Starlight's social icons.
import Default from '@astrojs/starlight/components/SocialIcons.astro'
---
<a class="open-app" href="/">Open app</a>
<Default />

<style>
  .open-app {
    display: inline-flex;
    align-items: center;
    height: 2rem;
    padding: 0 0.75rem;
    border-radius: var(--adbg-radius);
    background: var(--sl-color-text-accent);
    color: var(--sl-color-black);
    font-size: var(--sl-text-sm);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }
  .open-app:hover { opacity: 0.9; }
</style>
